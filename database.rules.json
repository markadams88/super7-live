{
  "rules": {
    ".read": false,
    ".write": false,
    "s7": {
      "current": { ".read": true, ".write": true },
      "sessions": {
        "$sid": {
          ".read": true,
          ".write": true,
          "state": { ".validate": "newData.hasChildren(['mode'])" },
          "st":  { "$uid": { "n": { ".validate": "newData.isString() && newData.val().length <= 24" } } },
          "an":  { "$key": { "$uid": {
                    "v":  { ".validate": "newData.isString() && newData.val().length <= 40" },
                    "xv": { ".validate": "newData.isString() && newData.val().length <= 40" },
                    "n":  { ".validate": "newData.isString() && newData.val().length <= 24" },
                    "c":  { ".validate": "newData.isNumber()" },
                    "x":  { ".validate": "newData.isNumber()" } } } },
          "msg": { "$uid": { "t": { ".validate": "newData.isString() && newData.val().length <= 120" } } },
          "req": { "$uid": { ".validate": "newData.isNumber() || newData.isString()" } },
          "bd":  { "$uid": { ".validate": "newData.hasChildren() || newData.val() == null" } },
          "inbox": { "$uid": {
                    "n":  { ".validate": "newData.isString() && newData.val().length <= 24" },
                    "t":  { ".validate": "newData.isString() && newData.val().length <= 140" },
                    "q":  { ".validate": "newData.isString() && newData.val().length <= 24" } } }
        }
      }
    }
  }
}
